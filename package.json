{
  "name": "starstrat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "convex dev --start \"vite\"",
    "predev": "convex init && node setup.mjs --once",
    "setup:auth": "npx @convex-dev/auth --skip-git-check --web-server-url http://localhost:5173",
    "build": "tsc -b && vite build",
    "lint": "tsc && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auth/core": "^0.37.0",
    "@convex-dev/auth": "^0.0.91",
    "@pixi/react": "^8.0.4",
